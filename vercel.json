{
    "outputDirectory":  "dist/spa",
    "buildCommand":  "pnpm build:client",
    "regions":  ["dub1"],
    "functions":  {
        "api/publish-work.ts":  {
            "maxDuration":  60,
            "includeFiles":  "node_modules/.pnpm/ffmpeg-static*/node_modules/ffmpeg-static/ffmpeg"
        }
    },
    "cleanUrls":  false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
            ]
        },
        {
            "source": "/((?!beats).*)",
            "headers": [
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.cloudinary.com; frame-src 'self' https://open.spotify.com https://www.youtube.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
            ]
        },
        {
            "source": "/submissions/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ],
    "rewrites":  [
                     {
                         "source": "/galeria",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/galeria/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/login",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/login/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/registro",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/registro/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/subir-obra",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/subir-obra/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/favoritos",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/favoritos/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/reset-password",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/reset-password/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/configuracion",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/configuracion/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/siguiendo",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/siguiendo/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/u/:username",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/u/:username/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/work/:id",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/work/:id/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/song/:id",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/song/:id/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/song",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/merch",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/merch/:slug",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/marketplace",
                         "destination": "/index.html"
                     },
                     {
                         "source": "/marketplace/:slug",
                         "destination": "/index.html"
                     },
                     {                         "source": "/api/(.*)",
                         "destination": "/api/$1"
                     },
                     {
                         "source": "/beats",
                         "destination": "/beats/index.html"
                     },
                     {
                         "source": "/beats/",
                         "destination": "/beats/index.html"
                     },
                     {
                         "source": "/beats/:path*",
                         "destination": "/beats/:path*"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/(.*)"
                     }
                 ]
}