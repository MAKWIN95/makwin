# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Configuration
# Use Resend for all backend transactional email in production.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=no-reply@makwin.art
HELP_EMAIL=help@makwin.art
ARTISTS_EMAIL=artists@makwin.art

# Vercel/Upstash Redis (persistent submissions storage)
STORAGE_KV_REST_API_URL=your_storage_kv_rest_api_url_here
STORAGE_KV_REST_API_TOKEN=your_storage_kv_rest_api_token_here

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary (Optional)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Development mode
NODE_ENV=development
PING_MESSAGE=pong
