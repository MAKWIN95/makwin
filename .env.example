# Email Configuration
# Choose one of the following email services

# Option 1: SendGrid (recommended for reliability)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@makwin.com

# Option 2: Resend (modern, email-first platform)
# RESEND_API_KEY=your_resend_api_key_here

# Option 3: Mailgun
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=your_domain.mailgun.org

# Recipient email for submissions
RECIPIENT_EMAIL=sendtomakwin@gmail.com

# Development mode
NODE_ENV=development
PING_MESSAGE=pong
