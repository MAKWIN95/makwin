# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Configuration
# Choose one of the following email services

# Option 1: SendGrid (recommended for reliability)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@makwin.com

# Option 2: Resend (modern, email-first platform)
# RESEND_API_KEY=your_resend_api_key_here

# Option 3: Mailgun
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=your_domain.mailgun.org

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary (Optional)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Recipient email for submissions
RECIPIENT_EMAIL=sendtomakwin@gmail.com

# Development mode
NODE_ENV=development
PING_MESSAGE=pong
